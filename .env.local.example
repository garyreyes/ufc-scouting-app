# Copy this file to .env.local (gitignored) and fill in real values.
# Find these in the Supabase dashboard: Project Settings > API.
# The anon key is safe to expose client-side — RLS is what actually
# restricts access, not secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# From dashboard.api-football.com > MMA > Live Demo/Documentation.
# Server-only secret — never prefix with NEXT_PUBLIC_.
UFC_API_SPORTS_KEY=

# From Supabase dashboard > Settings > API Keys > Secret keys.
# Bypasses RLS entirely — server-only, never expose client-side or commit.
SUPABASE_SERVICE_ROLE_KEY=
