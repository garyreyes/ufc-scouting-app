# Copy this file to .env.local (gitignored) and fill in real values.
# Find these in the Supabase dashboard: Project Settings > API.
# The anon key is safe to expose client-side — RLS is what actually
# restricts access, not secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# From dashboard.api-football.com > MMA > Live Demo/Documentation.
# Server-only secret — never prefix with NEXT_PUBLIC_.
UFC_API_SPORTS_KEY=

# From Supabase dashboard > Settings > API Keys > Secret keys.
# Bypasses RLS entirely — server-only, never expose client-side or commit.
SUPABASE_SERVICE_ROLE_KEY=

# From the-odds-api.com — free Starter tier, 500 credits/month.
# Server-only — never prefix with NEXT_PUBLIC_.
ODDS_API_KEY=

# Your own Supabase user id (select id from auth.users; while signed in as
# yourself). Must match the id hardcoded into is_owner() in
# supabase/migrations/0017_owner_allowlist.sql — the RLS policies are the
# real enforcement; this only decides what the UI shows. Not a secret (a
# user id can't be used to authenticate as that user), but still
# server-only since it's read via requireEnv, not NEXT_PUBLIC_.
OWNER_USER_ID=

# From aistudio.google.com/apikey (Google AI Studio) — sign in with any
# Google account, "Create API key", free tier. Server-only, never
# NEXT_PUBLIC_. Powers lib/llm.ts (Gemini Flash), the rumour engine's
# clustering step (Phase F) — verified empirically before anything real
# is built against it, per docs/PRD.md's own constraint.
GEMINI_API_KEY=

# From reddit.com/prefs/apps — "create app", type **script** (not "web
# app" or "installed app" — script apps get a client secret and don't
# need a redirect URI). The 14-character string under the app name is
# REDDIT_CLIENT_ID; "secret" is REDDIT_CLIENT_SECRET. Read-only access to
# public r/MMA posts — no Reddit password needed, no posting/commenting
# scope. Server-only.
# 2026-09-02: parked, not actively used -- Reddit's API now requires a
# manual, opaque approval process (see ROADMAP.md F1 result). Switched
# to Bluesky below as the actual social source.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# From bsky.app: Settings > Privacy and Security > App Passwords >
# "Add App Password". BLUESKY_IDENTIFIER is your handle (e.g.
# yourname.bsky.social) or the email you signed up with;
# BLUESKY_APP_PASSWORD is the generated password shown once at creation
# time -- NOT your real account password, and revocable independently of
# it. Needed because Bluesky's public read API works unauthenticated for
# basic lookups, but the search endpoint (what the rumour engine
# actually needs) requires a session. Server-only.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
