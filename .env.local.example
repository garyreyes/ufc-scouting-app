# Copy this file to .env.local (gitignored) and fill in real values.
# Find these in the Supabase dashboard: Project Settings > API.
# The anon key is safe to expose client-side — RLS is what actually
# restricts access, not secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# From dashboard.api-football.com > MMA > Live Demo/Documentation.
# Server-only secret — never prefix with NEXT_PUBLIC_.
UFC_API_SPORTS_KEY=

# From Supabase dashboard > Settings > API Keys > Secret keys.
# Bypasses RLS entirely — server-only, never expose client-side or commit.
SUPABASE_SERVICE_ROLE_KEY=

# From the-odds-api.com — free Starter tier, 500 credits/month.
# Server-only — never prefix with NEXT_PUBLIC_.
ODDS_API_KEY=

# Your own Supabase user id (select id from auth.users; while signed in as
# yourself). Must match the id hardcoded into is_owner() in
# supabase/migrations/0017_owner_allowlist.sql — the RLS policies are the
# real enforcement; this only decides what the UI shows. Not a secret (a
# user id can't be used to authenticate as that user), but still
# server-only since it's read via requireEnv, not NEXT_PUBLIC_.
OWNER_USER_ID=
