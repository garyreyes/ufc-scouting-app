# Copy this file to .env.local (gitignored) and fill in real values.
# Find these in the Supabase dashboard: Project Settings > API.
# The anon key is safe to expose client-side — RLS is what actually
# restricts access, not secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
