{
  "name": "ufc-scouting-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:recent": "dotenv -e .env.local -- tsx src/lib/ufc-data-sync/syncJob.ts",
    "sync:schedule": "dotenv -e .env.local -- tsx src/lib/ufc-data-sync/syncSchedule.ts",
    "sync": "npm run sync:recent && npm run sync:schedule",
    "odds:discover-start-times": "dotenv -e .env.local -- tsx src/lib/odds/runDiscoverStartTimes.ts",
    "odds:scheduled-job": "dotenv -e .env.local -- tsx src/lib/odds/runScheduledOddsJob.ts",
    "settlement:settle-fights": "dotenv -e .env.local -- tsx src/lib/settlement/runSettleFights.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
